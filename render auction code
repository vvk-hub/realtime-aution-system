    LANGUAGE plpgsql
    AS $$
DECLARE
    v_current_highest NUMERIC(12, 2);
    v_end_time TIMESTAMP WITH TIME ZONE;
BEGIN
    SELECT current_highest_bid, end_time 
    INTO v_current_highest, v_end_time
    FROM items 
    WHERE id = p_item_id 
    FOR UPDATE;

    IF NOW() > v_end_time THEN
        RAISE EXCEPTION 'Auction has already concluded.';
    END IF;

    IF p_amount <= v_current_highest THEN
        RAISE EXCEPTION 'Bid amount of % is less than or equal to current highest bid %.', p_amount, v_current_highest;
    END IF;

    INSERT INTO bids (item_id, bidder_name, amount)
    VALUES (p_item_id, p_bidder, p_amount);

    UPDATE items 
    SET current_highest_bid = p_amount 
    WHERE id = p_item_id;

    PERFORM pg_notify('auction_updates', json_build_object(
        'event', 'NEW_BID',
        'item_id', p_item_id,
        'highest_bid', p_amount,
        'bidder', p_bidder
    )::text);

    RETURN TRUE;
END;
$$;


